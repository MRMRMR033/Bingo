@model Bingo.Models.GameModel

@{
    ViewData["Title"] = "Detalles de juego";
}

<h1>Details</h1>

<div>
    <h4>GameModel</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.StartAt)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.StartAt)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EndAt)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EndAt)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IsActive)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IsActive)
        </dd>
    </dl>
</div>

<div>
    <h4>Cards</h4>
    <hr />
    <table class="table">
        <thead>
            <tr>
                <th>Folio</th>
                <th>Numbers</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var card in Model.Cards)
            {
                <tr>
                    <td>@card.Folio</td>
                    <td>
                        @* Mostrar la matriz de números de la carta *@
                        @if (!string.IsNullOrEmpty(card.Numbers))
                        {
                            // Dividir el string en una lista de enteros
                            var flatNumbers = card.Numbers.Split(',')
                            .Select(num => int.TryParse(num, out var n) ? n : (int?)null)
                            .ToArray();

                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        @for (int col = 0; col < 9; col++)
                                        {
                                            <th>@($"Column {col + 1}")</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int row = 0; row < 3; row++)
                                    {
                                        <tr>
                                            @for (int col = 0; col < 9; col++)
                                            {
                                                var index = row * 9 + col;
                                                <td>
                                                    @if (index < flatNumbers.Length && flatNumbers[index].HasValue)
                                                    {
                                                        @flatNumbers[index].Value
                                                    }
                                                    else
                                                    {
                                                        @* Usar espacio vacío para celdas vacías *@
                                                        <span>&nbsp;</span>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p>No numbers available</p>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
