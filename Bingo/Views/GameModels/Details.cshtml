@model Bingo.Models.GameModel

@{
    ViewData["Title"] = "Detalles del Juego de Bingo";
}

<h1>Detalles del Juego</h1>

<div>
    <h4>Información del Juego</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.StartAt)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.StartAt)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EndAt)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EndAt)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IsActive)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IsActive)
        </dd>
    </dl>
</div>
<div>
    <h4>Verificación de Datos</h4>
    <p>Número de Cartones: @Model.Cards?.Count() ?? 0</p>
</div>

<div>
    <h4>Cartones de Bingo Generados</h4>
    <hr />
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Folio</th>
                <th>Cartón de Bingo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var card in Model.Cards)
            {
                <tr>
                    <td>@card.Folio</td>
                    <td>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    @for (int col = 1; col <= 9; col++)
                                    {
                                        <th>@($"Columna {col}")</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Fila 1 -->
                                <tr>
                                    @foreach (var num in card.NumbersRowOne.Split(','))
                                    {
                                        <td>
                                            @if (num == "0")
                                            {
                                                <span>&nbsp;</span> <!-- Espacio vacío en lugar de 0 -->
                                            }
                                            else
                                            {
                                                @num <!-- Mostrar número -->
                                            }
                                        </td>
                                    }
                                </tr>

                                <!-- Fila 2 -->
                                <tr>
                                    @foreach (var num in card.NumbersRowTwo.Split(','))
                                    {
                                        <td>
                                            @if (num == "0")
                                            {
                                                <span>&nbsp;</span> <!-- Espacio vacío en lugar de 0 -->
                                            }
                                            else
                                            {
                                                @num <!-- Mostrar número -->
                                            }
                                        </td>
                                    }
                                </tr>

                                <!-- Fila 3 -->
                                <tr>
                                    @foreach (var num in card.NumbersRowTree.Split(','))
                                    {
                                        <td>
                                            @if (num == "0")
                                            {
                                                <span>&nbsp;</span> <!-- Espacio vacío en lugar de 0 -->
                                            }
                                            else
                                            {
                                                @num <!-- Mostrar número -->
                                            }
                                        </td>
                                    }
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Editar Juego</a> |
    <a asp-action="Index">Volver a la lista de Juegos</a>
</div>
